# Copy to `.env` (git-ignored) and fill in what you have. Every key is OPTIONAL in development:
# a provider with no key is simply skipped, and the site runs on the open-data sources alone.
# Full list, where to get each key, and the terms that come with it: docs/API-KEYS.md
#
# The API dev server and `pnpm ingest` read ../../.env automatically (Node's --env-file).

# --- Job and apprenticeship data keys (all free) ---------------------------------------------
# Find an apprenticeship (DfE "Display Advert API", v2). Free, self-serve, instant.
# Register: https://developer.apprenticeships.education.gov.uk/third-party-accounts/register
FAA_API_KEY=

# Reed jobseeker API. Free. Sign up: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Adzuna. Free tier (2,500 calls a month) BUT a 14-day trial rule applies to ongoing use: read
# docs/API-KEYS.md before relying on it. Register: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Needed only when you deploy ---------------------------------------------------------------
# Left commented on purpose: leave them unset in development. Uncomment and fill for production.

# Sign-in codes are e-mailed through Resend (https://resend.com). In development the code is
# printed to the API console instead, so you do not need this locally.
# RESEND_API_KEY=
# EMAIL_FROM="UnNEET <no-reply@your-domain.example>"

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=
# https:// in production.
# WEB_ORIGIN=https://your-domain.example
# Postgres connection string. Unset in development = the local PGlite dev database (pnpm db:dev).
# DATABASE_URL=
# At least 24 random characters. Lets a scheduler call POST /internal/ingest. Unset = routes off.
# INTERNAL_TOKEN=
